{
  "name": "Season",
  "type": "object",
  "properties": {
    "year": {
      "type": "integer",
      "description": "Season year (e.g., 1984)"
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "description": "Season start date"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "description": "Season end date"
    },
    "currentGameDay": {
      "type": "integer",
      "default": 1,
      "description": "Current day number (1-162)"
    },
    "currentDate": {
      "type": "string",
      "format": "date",
      "description": "Current simulated date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    },
    "userTeam": {
      "type": "string",
      "description": "Team key the user is managing"
    },
    "champion": {
      "type": "string",
      "description": "World Series winner team key"
    },
    "completedGames": {
      "type": "integer",
      "default": 0,
      "description": "Total games completed"
    },
    "totalGames": {
      "type": "integer",
      "default": 2430,
      "description": "Total season games (162 * 15 opponents)"
    },
    "rotationState": {
      "type": "object",
      "description": "Per-team rotation cooldown tracking: { teamKey: { lastStarted: { pitcherName: gameDay } } }"
    },
    "monthlyHonorsShown": {
      "type": "object",
      "description": "Map of 'YYYY-MM' to true for months whose honors have been displayed",
      "default": {}
    },
    "allStarRosters": {
      "type": "object",
      "description": "Generated All-Star rosters: { AL: { battingOrder, bench, pitchers }, NL: {...}, stadium, stadiumTeamKey, homeLeague }",
      "properties": {
        "AL": {
          "type": "object"
        },
        "NL": {
          "type": "object"
        },
        "stadium": {
          "type": "string"
        },
        "stadiumTeamKey": {
          "type": "string"
        },
        "homeLeague": {
          "type": "string"
        }
      }
    },
    "allStarBreakPhase": {
      "type": "string",
      "enum": [
        "break",
        "game_played",
        null
      ],
      "default": null,
      "description": "All-Star break state: 'break' = rosters generated, game playable; 'game_played' = game complete, show MVP; null = not in break"
    },
    "worldSeriesHomeFieldLeague": {
      "type": "string",
      "enum": [
        "AL",
        "NL",
        null
      ],
      "default": null,
      "description": "League that won the All-Star Game and gets World Series home-field advantage"
    },
    "allStarMvp": {
      "type": "object",
      "description": "All-Star Game MVP: { name, team, league, statLine, score }",
      "properties": {
        "name": {
          "type": "string"
        },
        "team": {
          "type": "string"
        },
        "league": {
          "type": "string"
        },
        "statLine": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      }
    },
    "allStarGameResult": {
      "type": "object",
      "description": "All-Star Game final result: { homeScore, awayScore, winner, winningLeague, homeTeam, awayTeam, stadium }",
      "properties": {
        "homeScore": {
          "type": "integer"
        },
        "awayScore": {
          "type": "integer"
        },
        "winner": {
          "type": "string"
        },
        "winningLeague": {
          "type": "string"
        },
        "homeTeam": {
          "type": "string"
        },
        "awayTeam": {
          "type": "string"
        },
        "stadium": {
          "type": "string"
        }
      }
    },
    "tradeDeadlinePhase": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        null
      ],
      "default": null,
      "description": "Trade deadline state: 'active' = trades generated, show screen; 'completed' = user has seen trades and continued; null = not triggered yet"
    },
    "tradeDeadlineTrades": {
      "type": "array",
      "description": "Generated trade deadline trades for display",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "year",
    "userTeam"
  ]
}